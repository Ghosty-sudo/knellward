{
  "name": "knellward",
  "version": "0.1.4",
  "description": "KNELLWARD - a compact dark-fantasy pixel RPG",
  "main": "electron/main.cjs",
  "scripts": {
    "serve": "npx http-server . -c-1 -p 4173",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable zip",
    "check": "node --check game.js && node --check runtime-patches.js && node --check mobile-controls.js && node tests/static-smoke.mjs && node tests/node-runtime-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "http-server": "^14.1.1"
  },
  "build": {
    "appId": "com.ghostysudo.knellward",
    "productName": "KNELLWARD",
    "files": [
      "index.html",
      "styles.css",
      "game.js",
      "runtime-patches.js",
      "mobile-controls.js",
      "payload/v012/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": ["portable", "zip"]
    },
    "artifactName": "KNELLWARD-${version}-${arch}.${ext}"
  }
}
